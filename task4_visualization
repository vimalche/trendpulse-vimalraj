##Task 4:: visualize

import pandas as pd
import matplotlib.pyplot as plt
import os

## Load csv file
df = pd.read_csv("data/trends_20240115_analysis.csv")

##create output folder
os.makedirs("output", exist_ok=True)
print("Output folder created")
print("Rows:",len(df))

plt.savefig("output/charts_top_10_stories.png")
print("Chart saved to output/charts_top_10_stories.png")

##select top 10
top_10 = df.nlargest(10, "score").copy()

top_10["short_title"] = top_10["title"].apply(lambda x: x[:50] + "..." if len(x) > 50 else x)
print("lengnth shorten longer than 50 character")

##Chart1 : create horizontalbar

plt.figure(figsize=(10, 6))
plt.barh(top_10["short_title"], top_10["score"], color="skyblue")

plt.gca().invert_yaxis()

##Title and Axis labels
plt.title("Top 10 Stories by Score")
plt.xlabel("Score")
plt.ylabel("Title")

##Save the chart
plt.savefig("output/charts1_top_10_stories.png")
print("Chart saved to output/charts1_top_10_stories.png")
plt.show()

## Chart2 : Stories per category

category_counts = df["category"].value_counts()
plt.figure(figsize=(8, 5))
plt.bar(category_counts.index, category_counts.values, color=["red","blue","green","orange","purple"])
plt.title("stories per category")
plt.xlabel("Category")
plt.ylabel("Number of Stories")
plt.savefig("output/charts2_stories_per_category.png")
print("Chart saved to output/charts2_stories_per_category.png")
plt.show()

## Chart3 : score vs comments

plt.figure(figsize=(10,6))

popular = df[df["is_popular"]]
unpopular = df[~df["is_popular"]]

plt.scatter(popular["score"], popular["num_comments"], label="Popular",color = "blue", alpha=0.5)
plt.scatter(unpopular["score"], unpopular["num_comments"], label="Unpopular", color = "red", alpha=0.5)

plt.title("Score vs Comments")
plt.xlabel("Score")
plt.ylabel("Number of Comments")
plt.legend()
plt.savefig("output/charts3_score_vs_comments.png")
print("Chart saved to output/charts3_score_vs_comments.png")
plt.show()


##Bonus step : Combine all into one Dashboard
fig, axis = plt.subplots(2, 2, figsize=(16, 10))


fig.suptitle("TrendPulse Dashboard",fontsize = 22, fontweight = "bold")

plt.savefig("output/dashboard.png")
print("Dashboard saved to output/dashboard.png")
plt.show()
